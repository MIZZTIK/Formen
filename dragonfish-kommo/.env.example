# ─────────────────────────────────────────────────────────────
#  Conector Dragonfish -> Kommo  ·  Formen
#  Copiá este archivo como .env y completá los valores reales.
# ─────────────────────────────────────────────────────────────

# ── Dragonfish (servicio REST local / on-premise) ──
# NOTA: los nombres/forma exactos hay que confirmarlos contra la
# instalación de Formen (ver README > "Dragonfish: a confirmar").
DF_BASE_URL=http://192.168.0.10:8009
DF_ID_CLIENTE=
DF_TOKEN=
DF_BASE_DE_DATOS=
# Tipo(s) de comprobante que cuentan como "venta" (coma-separado). Ej: FAC,FAB,TCK
DF_TIPOS_VENTA=FAC

# ── Kommo (CRM cloud) ──
# La cuenta de Formen es adminformenar.kommo.com (NO "formen").
KOMMO_SUBDOMAIN=adminformenar
# Integración privada de Kommo (Ajustes > Integraciones > Crear integración)
KOMMO_CLIENT_ID=
KOMMO_CLIENT_SECRET=
KOMMO_REDIRECT_URI=https://localhost/callback
# Se completan solos al correr `npm run kommo:auth` con el authorization_code:
KOMMO_ACCESS_TOKEN=
KOMMO_REFRESH_TOKEN=
# IDs de campos custom de contacto en Kommo (números). Dejar vacío si no se usan.
KOMMO_FIELD_ID_DNI=
KOMMO_FIELD_ID_TELEFONO=
KOMMO_FIELD_ID_EMAIL=

# ── Comportamiento del conector ──
# Cada cuánto consultar Dragonfish por ventas nuevas (ms). 60000 = 1 min.
POLL_INTERVAL_MS=60000
# Nivel de log: debug | info | warn | error
LOG_LEVEL=info
# Modo simulación: no escribe en Kommo, solo loguea lo que haría.
DRY_RUN=true
