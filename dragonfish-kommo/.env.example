# ─────────────────────────────────────────────────────────────
#  Conector Dragonfish -> Kommo  ·  Formen
#  Copiá este archivo como .env y completá los valores reales.
# ─────────────────────────────────────────────────────────────

# ── Dragonfish (SQL Server local) ──
# El servicio REST de Zoo Logic NO está instalado: se lee la base directo.
# SOLO SELECT: el conector nunca escribe en Dragonfish.
DF_SQL_SERVER=localhost
DF_SQL_INSTANCE=ZOOLOGIC
DF_SQL_DATABASE=DRAGONFISH_FORMEN
DF_SQL_SCHEMA=ZooLogic
# Usuario SQL de SOLO LECTURA, propio del conector (pedírselo al soporte de
# Zoo Logic). No usar las credenciales de Windows de una persona.
# Requiere que SQL Server esté en modo de autenticación mixta.
DF_SQL_USER=
DF_SQL_PASSWORD=
DF_SQL_ENCRYPT=false
DF_SQL_TRUST_CERT=true
# FACTTIPO que cuentan como venta. 2 = el grueso (facturas/tickets A y B).
DF_TIPOS_VENTA=2

# ── Kommo (CRM cloud) ──
# La cuenta de Formen es adminformenar.kommo.com (NO "formen").
KOMMO_SUBDOMAIN=adminformenar
# Token de larga duración de la integración privada DEL CONECTOR.
# No reusar el token del bot de n8n: si se rota uno, se cae el otro.
# Ajustes > Integraciones > (la integración) > "Llaves y ámbitos".
# SIN el prefijo "Bearer".
KOMMO_ACCESS_TOKEN=

# Campos de contacto en Kommo (relevados el 19/8/2026). No hay campo de DNI.
KOMMO_FIELD_ID_TELEFONO=326778
KOMMO_FIELD_ID_EMAIL=326780
KOMMO_FIELD_ID_DNI=

# Usuario de Kommo con el que está logueado el iPad del local: los contactos
# que crea aparecen con este created_by. Es lo único que los distingue de los
# que entran por WhatsApp (no hay "fuentes" configuradas en la cuenta).
KOMMO_IPAD_USER_ID=15483335

# Solo si algún día se usa el flujo OAuth completo en vez del token largo.
KOMMO_CLIENT_ID=
KOMMO_CLIENT_SECRET=
KOMMO_REDIRECT_URI=https://localhost/callback
KOMMO_REFRESH_TOKEN=

# ── Apareo venta <-> contacto ──
# El vendedor pasa el iPad DESPUÉS de cobrar: la ventana es asimétrica, se
# buscan contactos creados entre la venta y N minutos después.
MATCH_VENTANA_MIN=10
# Cuánto esperar antes de evaluar una venta (tiene que ser > MATCH_VENTANA_MIN).
MATCH_ESPERA_MIN=15

# ── Comportamiento ──
POLL_INTERVAL_MS=60000
LOG_LEVEL=info
# Modo medición: NO escribe en Kommo, solo mide la tasa de apareo.
# Dejarlo en true hasta que `npm run medir` muestre una tasa aceptable.
DRY_RUN=true
